# Database and frontend configuration
ECOLINGS_DATABASE_URL=sqlite:///./ecolings.db
ECOLINGS_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional OpenAI features. Keep this key on the backend only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_DYNAMIC_QUESTS=true
OPENAI_DIALOGUE=true

# In-process safety limit. Render restarts reset this estimate; use the OpenAI
# project budget as the authoritative hard ceiling.
OPENAI_DAILY_BUDGET_USD=2.00
OPENAI_TIMEOUT_SECONDS=20
OPENAI_INPUT_USD_PER_MTOK=0.75
OPENAI_OUTPUT_USD_PER_MTOK=4.50
